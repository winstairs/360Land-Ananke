# Copia in .env e personalizza. Il file .env non va mai committato.

# Modalità di deploy. Standalone (default): solo Ananke. Ecosistema: Ananke più i servizi collegati
# (docker-compose.ecosystem.yml, ancora da definire). Decommenta per attivare l'ecosistema.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ecosystem.yml

# Database
POSTGRES_USER=ananke
POSTGRES_PASSWORD=ananke-dev-password
POSTGRES_DB=ananke

# Agenti: mock (simulazione, nessuna chiave richiesta) oppure live (chiamate reali tramite il gateway)
LLM_MODE=mock
LITELLM_MASTER_KEY=sk-ananke-local-change-me
# Cifra le credenziali salvate dal gateway nel suo database: sceglila una volta e non cambiarla
LITELLM_SALT_KEY=sk-ananke-salt-change-me

# Chiavi dei provider LLM. Aggiungi qui ogni variabile indicata nella scheda «Modelli AI» della configurazione:
# il gateway le legge da questo file, Ananke non le salva mai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HETZNER_LLM_API_KEY=
OPEN_CLOUD_API_KEY=

# Applicazione
APP_TIMEZONE=Europe/Rome
WORKER_POLL_SECONDS=30
WEB_PORT=8080
API_PORT=8000
