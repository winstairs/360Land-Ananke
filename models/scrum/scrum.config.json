{
  "id": "default-scrum",
  "version": "1.2.0",
  "processModel": "scrum-e2e",
  "agentTopology": "scrum-e2e-agents",
  "policy": {
    "requireHumanApprovers": true,
    "requireHumanAccountable": true,
    "crossFamilyReview": true
  },
  "agentPresets": [
    {
      "id": "claude-reasoning",
      "name": "Claude ragionamento",
      "kind": "llm-agent",
      "runtime": "langgraph",
      "model": "anthropic/claude-opus",
      "temperature": 0.2,
      "maxIterations": 30,
      "capabilities": [
        "architettura",
        "verifica",
        "decisioni"
      ]
    },
    {
      "id": "claude-worker",
      "name": "Claude redazione e analisi",
      "kind": "llm-agent",
      "runtime": "langgraph",
      "model": "anthropic/claude-sonnet",
      "temperature": 0.3,
      "maxIterations": 25,
      "capabilities": [
        "documenti",
        "analisi",
        "pianificazione"
      ],
      "allowedConnectors": [
        "atlassian-jira",
        "atlassian-confluence",
        "google-drive"
      ]
    },
    {
      "id": "claude-code-agent",
      "name": "Claude coding agent",
      "kind": "llm-agent",
      "runtime": "claude-agent-sdk",
      "model": "anthropic/claude-sonnet",
      "temperature": 0,
      "maxIterations": 80,
      "capabilities": [
        "codice",
        "sandbox",
        "repo"
      ],
      "allowedConnectors": [
        "github"
      ]
    },
    {
      "id": "open-generalist",
      "name": "Generalista open self-hosted",
      "kind": "llm-agent",
      "runtime": "langgraph",
      "model": "ollama-local/oss-generalist",
      "temperature": 0.2,
      "maxIterations": 25,
      "capabilities": [
        "analisi",
        "dati sensibili on-prem"
      ]
    },
    {
      "id": "open-coder",
      "name": "Coder open self-hosted",
      "kind": "llm-agent",
      "runtime": "langgraph",
      "model": "ollama-local/oss-coder",
      "fallbackModel": "ollama-local/oss-coder-small",
      "temperature": 0,
      "maxIterations": 60,
      "capabilities": [
        "test",
        "codice"
      ],
      "allowedConnectors": [
        "github"
      ]
    },
    {
      "id": "open-light",
      "name": "Agente leggero open",
      "kind": "llm-agent",
      "runtime": "langgraph",
      "model": "ollama-local/oss-light",
      "temperature": 0,
      "maxIterations": 15,
      "capabilities": [
        "triage",
        "classificazione",
        "automazione"
      ]
    },
    {
      "id": "rovo-agent",
      "name": "Atlassian Rovo (agente verticale)",
      "kind": "external-agent",
      "runtime": "a2a",
      "endpoint": "https://a2a.atlassian.com/v1/rovo",
      "capabilities": [
        "ricerca e sintesi Jira/Confluence",
        "creazione work item e pagine"
      ]
    }
  ],
  "connectors": [
    {
      "id": "atlassian-jira",
      "name": "Jira Cloud",
      "system": "jira",
      "category": "work-tracking",
      "transport": "mcp-remote",
      "endpoint": "https://mcp.atlassian.com/v2/mcp",
      "status": "ga",
      "notes": "Rovo MCP server, stesso endpoint di Confluence",
      "settings": {
        "auth": "oauth",
        "siteUrl": "https://azienda.atlassian.net",
        "projectKey": "ANANKE",
        "issueType": "Task"
      }
    },
    {
      "id": "atlassian-confluence",
      "name": "Confluence Cloud",
      "system": "confluence",
      "category": "knowledge-base",
      "transport": "mcp-remote",
      "endpoint": "https://mcp.atlassian.com/v2/mcp",
      "status": "ga",
      "settings": {
        "auth": "oauth",
        "siteUrl": "https://azienda.atlassian.net",
        "spaceKey": "ANANKE"
      }
    },
    {
      "id": "clickup",
      "name": "ClickUp",
      "system": "clickup",
      "category": "work-tracking",
      "transport": "mcp-remote",
      "endpoint": "https://mcp.clickup.com/mcp",
      "status": "ga",
      "notes": "Solo OAuth; nessuna cancellazione di liste, cartelle o documenti",
      "settings": {
        "auth": "oauth"
      }
    },
    {
      "id": "plane",
      "name": "Plane self-hosted",
      "system": "plane",
      "category": "work-tracking",
      "transport": "rest",
      "endpoint": "https://plane.internal/api/v1",
      "status": "ga",
      "notes": "Community Edition AGPL-3.0: usata come servizio separato, non incorporata",
      "settings": {
        "auth": "api-key",
        "tokenEnv": "PLANE_API_KEY",
        "workspaceSlug": "ananke"
      }
    },
    {
      "id": "google-drive",
      "name": "Google Drive",
      "system": "google-drive",
      "category": "file-storage",
      "transport": "mcp-remote",
      "endpoint": "https://drivemcp.googleapis.com/mcp/v1",
      "status": "preview",
      "notes": "Developer preview di Google Workspace",
      "settings": {
        "auth": "oauth"
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "system": "github",
      "category": "code-hosting",
      "transport": "mcp-remote",
      "status": "ga",
      "endpoint": "https://api.githubcopilot.com/mcp/",
      "settings": {
        "auth": "oauth",
        "owner": "azienda",
        "toolsets": [
          "repos",
          "issues",
          "pull_requests"
        ]
      }
    }
  ],
  "bindings": {
    "workTracking": "atlassian-jira",
    "knowledgeBase": "atlassian-confluence",
    "fileStorage": "google-drive",
    "codeHosting": "github",
    "artifactStorage": {
      "product-goal": "atlassian-confluence",
      "product-backlog": "atlassian-jira",
      "definition-of-ready": "atlassian-confluence",
      "definition-of-done": "atlassian-confluence",
      "sprint-goal": "atlassian-jira",
      "sprint-backlog": "atlassian-jira",
      "source-code": "github",
      "build": "github",
      "test-report": "atlassian-confluence",
      "increment": "github",
      "burndown": "atlassian-jira",
      "impediment-log": "atlassian-jira",
      "review-notes": "atlassian-confluence",
      "retro-actions": "atlassian-confluence",
      "release-notes": "atlassian-confluence"
    }
  },
