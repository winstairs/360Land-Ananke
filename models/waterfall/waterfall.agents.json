{
  "id": "waterfall-e2e-agents",
  "name": "Topologia agenti per la pipeline waterfall",
  "version": "1.1.0",
  "description": "PM Office agentico come supervisore, un orchestratore per fase con agenti specialisti. Gli agenti preparano e verificano; le decisioni di gate restano agli approvatori umani del ProcessModel.",
  "processModel": "waterfall-e2e",
  "supervisor": {
    "id": "pm-office",
    "name": "PM Office agentico",
    "description": "Supervisione dell'intero ciclo: stato del progetto, transizioni tra fasi, processi trasversali, escalation verso gli umani",
    "lead": "pm-lead-agent",
    "agents": [
      {
        "id": "pm-lead-agent",
        "name": "Coordinatore PM",
        "responsibilities": [
          "Governa la macchina a stati del processo: attiva la fase successiva solo dopo l'approvazione umana del gate",
          "Passa input e vincoli all'orchestratore di fase e ne riceve gli esiti",
          "Esegue le transizioni di ritorno (difetti, change request) su proposta degli agenti competenti",
          "Riceve le escalation degli orchestratori e decide se risolverle o portarle all'umano"
        ],
        "supportsRole": "pm",
        "autonomy": "supervised",
        "tools": [
          "process-state-store",
          "orchestrator-dispatch",
          "notifications"
        ],
        "scheduledTasks": [
          {
            "id": "read-gate-decisions",
            "name": "Lettura decisioni di gate",
            "cron": "*/30 8-19 * * 1-5",
            "action": "apply-gate-decisions"
          }
        ]
      },
      {
        "id": "planner-agent",
        "name": "Agente di pianificazione e controllo",
        "responsibilities": [
          "Mantiene la baseline di tempi, costi e ambito",
          "Misura l'avanzamento rispetto al piano e segnala gli scostamenti",
          "Propone ripianificazioni al Coordinatore PM"
        ],
        "consumes": [
          "pm-plan"
        ],
        "supportsRole": "pm",
        "autonomy": "advisory",
        "tools": [
          "project-schedule",
          "spreadsheet"
        ],
        "scheduledTasks": [
          {
            "id": "plan-progress",
            "name": "Avanzamento rispetto al piano",
            "cron": "0 9 * * 1"
          }
        ]
      },
      {
        "id": "risk-agent",
        "name": "Agente gestione rischi",
        "responsibilities": [
          "Redige il piano di gestione dei rischi in fase di pianificazione",
          "Mantiene il registro rischi e raccoglie segnali da tutti gli orchestratori",
          "Propone risposte ai rischi e ne monitora l'efficacia"
        ],
        "activities": [
          "risk-plan"
        ],
        "supportsRole": "pm",
        "autonomy": "advisory",
        "crossCutting": "risk-management",
        "tools": [
          "risk-register"
        ],
        "scheduledTasks": [
          {
            "id": "risk-plan",
            "name": "Piano di gestione dei rischi",
            "cron": "0 10 * * 1-5",
            "activity": "risk-plan"
          },
          {
            "id": "risk-register",
            "name": "Aggiornamento registro rischi",
            "cron": "0 12 * * 1-5"
          }
        ]
      },
      {
        "id": "gatekeeper-agent",
        "name": "Agente di verifica dei gate",
        "responsibilities": [
          "Verifica in modo indipendente i criteri di uscita di ogni gate, senza aver prodotto gli artefatti di fase",
          "Compone il pacchetto di evidenze per gli approvatori umani",
          "Restituisce all'orchestratore i criteri non soddisfatti per il rework"
        ],
        "supportsRole": "pm",
        "autonomy": "advisory",
        "tools": [
          "artifact-read",
          "traceability-query"
        ],
        "scheduledTasks": [
          {
            "id": "check-gate",
            "name": "Verifica criteri di gate",
            "cron": "0 8 * * 1-5"
          },
          {
            "id": "evidence-pack",
            "name": "Preparazione pacchetto evidenze",
            "cron": "0 16 * * 5"
          }
        ]
      },
      {
        "id": "change-agent",
        "name": "Agente change control",
        "responsibilities": [
          "Registra le change request da qualunque fase",
          "Esegue l'analisi d'impatto su requisiti, design, codice, tempi e costi",
          "Propone al Coordinatore PM la transizione di ritorno e l'approvazione umana necessaria"
        ],
        "activities": [
          "change-management"
        ],
        "produces": [
          "change-log"
        ],
        "supportsRole": "pm",
        "autonomy": "advisory",
        "crossCutting": "change-control",
        "tools": [
          "change-register",
          "traceability-query"
        ],
        "scheduledTasks": [
          {
            "id": "change-management",
            "name": "Analisi delle change request aperte",
            "cron": "0 10 * * 1-5",
            "activity": "change-management"
          }
        ]
      },
      {
        "id": "traceability-agent",
        "name": "Agente di tracciabilità",
        "responsibilities": [
          "Costruisce la matrice di tracciabilità in fase di requisiti",
          "La mantiene aggiornata lungo tutte le fasi: requisito, design, codice, test, rilascio",
          "Segnala requisiti senza copertura di design o di test"
        ],
        "activities": [
          "traceability"
        ],
        "consumes": [
          "srs"
        ],
        "produces": [
          "traceability-matrix"
        ],
        "supportsRole": "ba",
        "autonomy": "autonomous",
        "tools": [
          "traceability-store",
          "repo-read"
        ],
        "scheduledTasks": [
          {
            "id": "traceability",
            "name": "Aggiornamento matrice di tracciabilità",
            "cron": "0 */4 * * 1-5",
            "activity": "traceability"
          },
          {
            "id": "coverage-gaps",
            "name": "Segnalazione requisiti senza copertura",
            "cron": "30 17 * * 5"
          }
        ]
      },
      {
        "id": "qa-auditor-agent",
        "name": "Agente quality assurance",
        "responsibilities": [
          "Verifica la conformità al piano qualità in ogni fase",
          "Esegue audit di processo indipendenti dagli agenti che producono il lavoro",
          "Segnala non conformità al Coordinatore PM"
        ],
        "consumes": [
          "pm-plan"
        ],
        "supportsRole": "qa",
        "autonomy": "advisory",
        "crossCutting": "quality-assurance",
        "tools": [
          "artifact-read",
          "checklists"
        ],
        "scheduledTasks": [
          {
            "id": "quality-audit",
            "name": "Audit di conformità al piano qualità",
            "cron": "0 11 * * 3"
          }
        ]
      },
      {
        "id": "config-agent",
        "name": "Agente configuration management",
        "responsibilities": [
          "Versiona le baseline degli artefatti a ogni gate approvato",
          "Gestisce tag di release e coerenza tra versioni di documenti, codice e build",
          "Esegue l'archiviazione documentale in chiusura"
        ],
        "activities": [
          "archive"
        ],
        "supportsRole": "ops",
        "autonomy": "autonomous",
        "crossCutting": "configuration-management",
        "tools": [
          "repo-write",
          "document-store"
        ],
        "scheduledTasks": [
          {
            "id": "baseline",
            "name": "Versionamento delle baseline approvate",
            "cron": "0 20 * * 1-5"
          },
          {
            "id": "archive",
            "name": "Archiviazione documentale",
            "cron": "0 18 * * 5",
            "activity": "archive"
          }
        ]
      },
      {
        "id": "reporting-agent",
        "name": "Agente di reporting",
        "responsibilities": [
          "Produce i report di avanzamento periodici",
          "Prepara le comunicazioni agli stakeholder secondo il piano di comunicazione",
          "Invia solo dopo revisione umana"
        ],
        "consumes": [
          "pm-plan"
        ],
        "supportsRole": "pm",
        "autonomy": "supervised",
        "crossCutting": "progress-reporting",
        "tools": [
          "docs",
          "email"
        ],
        "scheduledTasks": [
          {
            "id": "weekly-report",
            "name": "Report settimanale agli stakeholder",
            "cron": "0 17 * * 5"
          }
        ]
      }
    ]
  },
  "orchestratorDefaults": {
    "responsibilities": [
      "Riceve dal Coordinatore PM input, vincoli e criteri del gate di fase",
      "Scompone le attività di fase in task e li assegna agli agenti specialisti",
      "Gestisce dipendenze e parallelismo tra gli agenti",
      "Aggrega gli output e si assicura che ogni artefatto atteso sia prodotto",
      "Sottopone il pacchetto di fase al gatekeeper e gestisce il rework",
      "Segnala rischi al risk-agent e change request al change-agent",
      "Scala al Coordinatore PM blocchi, conflitti e decisioni fuori mandato"
    ]
  },
