      "test-plan": "atlassian-confluence",
      "source-code": "github",
      "build": "github",
      "test-report": "atlassian-confluence",
      "defect-log": "atlassian-jira",
      "release-notes": "atlassian-confluence",
      "user-manual": "google-drive",
      "runbook": "atlassian-confluence",
      "change-log": "atlassian-jira",
      "lessons-learned": "atlassian-confluence",
      "closure-report": "atlassian-confluence"
    }
  },
